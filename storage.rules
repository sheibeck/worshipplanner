rules_version = '2';

// See .planning/codebase/ARCHITECTURE.md (Backend Behavioral Notes (R318) § storage.rules)
// Org-scoped Storage access control, mirroring firestore.rules' isOrgMember pattern.
service firebase.storage {
  match /b/{bucket}/o {
    // See .planning/codebase/INTEGRATIONS.md (Backend Integration Notes (R318) § storage.rules)
    // `!= null` guards the absent-key case (a legacy, pre-Phase-76 token shape) as "not deactivated".
    function isOrgDeactivatedForCaller(orgId) {
      return request.auth.token.get('deactivatedOrgs', {}).get(orgId, false) == true;
    }

    function isOrgMemberByClaim(orgId) {
      return request.auth != null
        && (
          // Phase 78 (R225): checked first -- a super-admin gets Storage
          // read/write on ANY org's path with NO orgId/orgs/role claim
          // entry at all, and regardless of deactivatedOrgs (mirrors the
          // Phase 76 deactivation exemption, now unconditional rather than
          // membership-gated). The old `|| request.auth.token.superAdmin ==
          // true` that lived ONLY inside the deactivation sub-clause below
          // is removed as dead code -- this outer arm already subsumes it.
          request.auth.token.superAdmin == true
          ||
          (
            (
              // NEW — multi-org arm (R209): the claim's orgs map carries an entry for
              // this org. Guard orgs != null BEFORE indexing it -- indexing into an
              // absent orgs key is a rules evaluation error (hard deny), not a clean
              // false.
              (request.auth.token.orgs != null && request.auth.token.orgs[orgId] != null)
              // Legacy arm (R211 backward-compat): pre-widening / not-yet-backfilled
              // tokens still carry only the primary orgId/role — kept unchanged,
              // unconditionally ORed (never ANDed) with the new arm above.
              || (request.auth.token.orgId == orgId && request.auth.token.role != null)
            )
            && !isOrgDeactivatedForCaller(orgId)
          )
        );
    }

    // Membership is CLAIM-ONLY as of Deploy 2 (2026-08-12). Do NOT re-introduce a
    // cross-service firestore.exists() fallback here: it is inert in the Storage emulator
    // (firebase-js-sdk#6803), which is exactly how a deny-everyone rule once shipped
    // undetected. The claim arm is the single source of authority; the "claim-only
    // membership" test in src/storage.rules.test.ts guards that the fallback stays removed.
    function isOrgMember(orgId) {
      return isOrgMemberByClaim(orgId);
    }

    // Phase 122 (R372): mirrors isOrgMemberByClaim's exact structure (same
    // superAdmin outer arm, same multi-org/legacy-arm OR, same
    // isOrgDeactivatedForCaller wrap) but requires the resolved role to be
    // editor/admin rather than merely non-null. 'admin' is intentionally
    // synonymous with 'editor' (mirrors firestore.rules' isOrgEditor,
    // R348/SEC-ISO-05). CLAIM-ONLY — see isOrgMemberByClaim's comment above
    // for why a cross-service firestore.exists() must never be added here.
    function isOrgEditorByClaim(orgId) {
      return request.auth != null
        && (
          request.auth.token.superAdmin == true
          ||
          (
            (
              (request.auth.token.orgs != null
                && request.auth.token.orgs[orgId] != null
                && request.auth.token.orgs[orgId] in ['editor', 'admin'])
              || (request.auth.token.orgId == orgId
                && request.auth.token.role in ['editor', 'admin'])
            )
            && !isOrgDeactivatedForCaller(orgId)
          )
        );
    }

    // Phase 122 (R372): editor-tier gate for song-files create/delete.
    function isOrgEditor(orgId) {
      return isOrgEditorByClaim(orgId);
    }

    // Cloud Storage rules do NOT cascade between sibling `match` blocks — this
    // more-specific `orgs/{orgId}/media/**` match is evaluated independently of
    // the generic `orgs/{orgId}/{allPaths=**}` block below (proven by the media
    // rules tests in src/storage.rules.test.ts, not merely assumed).
    //
    // Phase 22 (R014) media attachments (audio/video) run larger than the
    // researched PPTX-import cap, so this path gets its own, higher size
    // ceiling while every other org-scoped path (pptx-imports, etc.) keeps the
    // original 25MB cap unchanged below.
    match /orgs/{orgId}/media/{allPaths=**} {
      allow read: if isOrgMember(orgId);

      // 50MB (52428800 bytes) — the researched media cap (22-RESEARCH.md) for
      // audio/video attachments, mirrored by useMediaUpload's MEDIA_MAX_BYTES.
      allow write: if isOrgMember(orgId)
                      && request.resource.size < 52428800;
    }

    // Phase 122 (R364, R372): permanent, org-scoped home for Song attachments
    // (chord charts / lead sheets / audio), deliberately OUTSIDE media/ so the
    // retention sweeps in functions/src/cleanupSweeps.ts structurally never
    // match it (see 122-RESEARCH.md Must-Resolve #3). Explicit create/update/
    // delete verbs, NOT bundled `write` — `write` would bundle delete, and
    // request.resource is null on delete (referencing request.resource.size/
    // .name on a delete errors -> denies that clause), so delete needs its own
    // unconditioned grant.
    match /orgs/{orgId}/song-files/{allPaths=**} {
      allow read: if isOrgMember(orgId);

      allow create: if isOrgEditor(orgId)
                       && request.resource.size < 52428800
                       && request.resource.contentType in ['application/pdf', 'audio/mpeg'];

      // Attachments are immutable once uploaded — every re-upload uses a new
      // attachmentId/path (122-CONTEXT.md's path scheme), so denying update
      // closes an in-place-overwrite bypass of the create-time type check.
      allow update: if false;

      allow delete: if isOrgEditor(orgId);
    }

    match /orgs/{orgId}/{allPaths=**} {
      // Song-files is excluded here — it has its own, MORE RESTRICTIVE block
      // above. Storage rule blocks are OR-combined, so without this exclusion
      // this catch-all's permissive isOrgMember/<25MB grant would still allow
      // an oversized-for-song-files-but-under-25MB, or non-PDF/MP3, write to
      // song-files/ regardless of the dedicated block's deny (122-RESEARCH.md
      // Pitfall 1). This exclusion is MANDATORY, not optional.
      allow read: if isOrgMember(orgId)
                     && !resource.name.matches('^orgs/[^/]+/song-files/.*');

      // Same membership condition for write, plus a per-upload size ceiling. 25MB
      // (26214400 bytes) is the researched starting cap for this milestone's PPTX
      // imports (21-RESEARCH.md Open Question 3) — tunable, not a hard product limit.
      allow write: if isOrgMember(orgId)
                      && request.resource.size < 26214400
                      && !request.resource.name.matches('^orgs/[^/]+/song-files/.*');
    }
  }
}
