rules_version = '2';

// Org-scoped Storage access control, mirroring firestore.rules' isOrgMember pattern.
// The generic orgs/{orgId} prefix is intentional (not PPTX-specific) so Phase 22's media
// attachments and any future Storage-backed feature can reuse this same rule.
//
// v1.5 claim migration (phase 40) — COMPLETE (Deploy 2, 2026-08-12). Membership is now
// proven SOLELY by the custom auth claim: the pre-existing cross-service
// firestore.exists() fallback arm has been removed. The claim arm is emulator-verifiable,
// whereas firestore.exists() is inert in the Storage emulator (firebase-js-sdk#6803) —
// the exact defect that once let a deny-everyone rule reach production undetected for a
// milestone (see CLAUDE.md). Before the fallback was removed, every user was confirmed
// single-org (backfill dry-run + mandatory pre-check) and all live tokens were soaked so
// they carry the claim. Full runbook: functions/DEPLOY-ORG-CLAIMS.md.
service firebase.storage {
  match /b/{bucket}/o {
    // Reads request.auth.token.orgId / .role — a direct JWT claim read set server-side by
    // Cloud Function syncOrgMembershipClaim (functions/src/orgMembershipClaims.ts,
    // phase 40-02) via the Admin SDK, plus the one-off backfill. No cross-service call is
    // involved, so this is fully verifiable in the emulator. `role != null` (not a specific
    // role) is the gate — any assigned role counts as membership.
    //
    // KNOWN LIMITATION (D-01/D-04): the claim carries only the user's PRIMARY org
    // (orgIds[0]). Safe today because every user is single-org, verified at the 2026-08-12
    // migration. The Firestore fallback that used to cover a user's NON-primary orgs is
    // gone, so if a user is ever to belong to more than one org, the claim must first be
    // widened to carry all their orgs. Tracked in .planning/ROADMAP.md backlog.
    function isOrgMemberByClaim(orgId) {
      return request.auth != null
        && request.auth.token.orgId == orgId
        && request.auth.token.role != null;
    }

    // Membership is CLAIM-ONLY as of Deploy 2 (2026-08-12). Do NOT re-introduce a
    // cross-service firestore.exists() fallback here: it is inert in the Storage emulator
    // (firebase-js-sdk#6803), which is exactly how a deny-everyone rule once shipped
    // undetected. The claim arm is the single source of authority; the "claim-only
    // membership" test in src/storage.rules.test.ts guards that the fallback stays removed.
    function isOrgMember(orgId) {
      return isOrgMemberByClaim(orgId);
    }

    // Cloud Storage rules do NOT cascade between sibling `match` blocks — this
    // more-specific `orgs/{orgId}/media/**` match is evaluated independently of
    // the generic `orgs/{orgId}/{allPaths=**}` block below (proven by the media
    // rules tests in src/storage.rules.test.ts, not merely assumed).
    //
    // Phase 22 (R014) media attachments (audio/video) run larger than the
    // researched PPTX-import cap, so this path gets its own, higher size
    // ceiling while every other org-scoped path (pptx-imports, etc.) keeps the
    // original 25MB cap unchanged below.
    match /orgs/{orgId}/media/{allPaths=**} {
      allow read: if isOrgMember(orgId);

      // 50MB (52428800 bytes) — the researched media cap (22-RESEARCH.md) for
      // audio/video attachments, mirrored by useMediaUpload's MEDIA_MAX_BYTES.
      allow write: if isOrgMember(orgId)
                      && request.resource.size < 52428800;
    }

    match /orgs/{orgId}/{allPaths=**} {
      allow read: if isOrgMember(orgId);

      // Same membership condition for write, plus a per-upload size ceiling. 25MB
      // (26214400 bytes) is the researched starting cap for this milestone's PPTX
      // imports (21-RESEARCH.md Open Question 3) — tunable, not a hard product limit.
      allow write: if isOrgMember(orgId)
                      && request.resource.size < 26214400;
    }
  }
}
