rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // See .planning/codebase/ARCHITECTURE.md (Backend Behavioral Notes (R318) § firestore.rules)
    // exists()-guarded FIRST: an unguarded get() on a missing org doc throws (DENY, not false).
    function isOrgActive(orgId) {
      return !exists(/databases/$(database)/documents/organizations/$(orgId)) ||
        get(/databases/$(database)/documents/organizations/$(orgId)).data.get('active', true) == true;
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        // See .planning/codebase/ARCHITECTURE.md (Backend Behavioral Notes (R318) § firestore.rules)
        // Checked FIRST for cost (short-circuits the billed exists() read) and correctness.
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          isOrgActive(orgId))
      );
    }

    function isOrgEditor(orgId) {
      // exists()-guarded like isOrgMember: an unguarded get().data.role throws a
      // "Null value error" (which Firestore treats as DENY, not false) when the
      // caller has no member doc, or the doc has no `role` field. That error —
      // surfacing at this call site — is what blocked the slideGroups delete rule
      // (evaluation error @ L153) from ever reaching its own conditions. Now it
      // resolves to a clean false instead of erroring.
      return isSignedIn() && (
        // See .planning/codebase/ARCHITECTURE.md (Backend Behavioral Notes (R318) § firestore.rules)
        // NOTE: this makes isOrgEditor(orgId) true for every super-admin on every org.
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', '') in ['editor', 'admin'] &&
          isOrgActive(orgId))
      );
    }

    // See .planning/codebase/ARCHITECTURE.md (Backend Behavioral Notes (R318) § firestore.rules)
    // Deliberately CLAIM-ONLY -- avoids the cross-document lookup fragility class (CLAUDE.md, 2026-08-06 incident).
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }

    // User profiles - only the owner can read/write their own profile
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Organizations
    match /organizations/{orgId} {
      // T-76-10/T-76-06 (Phase 76 SECURITY follow-up): `active`, `deactivatedAt`,
      // `deactivatedBy`, `reactivatedAt`, `reactivatedBy` are written ONLY by the
      // setOrgActive Cloud Function via the Admin SDK, which bypasses these rules
      // entirely -- no legitimate client write (an ordinary editor's org-settings
      // update, or the legacy client-side org-create path below) ever needs to
      // touch any of them. Without this guard, an ordinary EDITOR (not a
      // super-admin) could `updateDoc(organizations/{orgId}, {active: false,
      // deactivatedAt: ..., deactivatedBy: 'forged'})` directly from the client --
      // bypassing the super-admin-gated setOrgActive callable, the
      // deactivatedOrgs claim fan-out, and revokeRefreshTokens (T-76-10), and
      // forging the deactivatedBy audit field (T-76-06). Mirrors the
      // diff().affectedKeys() idiom already used by the services/{docId} block
      // below. Exempted for a genuine super-admin (same narrow OR pattern used
      // by isOrgActive/isOrgMember/isOrgEditor above) -- a super-admin already
      // sits above this boundary elsewhere in this file (appConfig, superAdmins),
      // so this is not a new escalation surface; T-76-10's exploit is
      // See ADR-0001 (docs/adr/0001-super-admin-explicitly-enables-it-written-only-by-the.md)
      // Phase 101 (R295): `bibleApiEnabled` -- the second super-admin-only
      // master gate (this one for the Bible API, ESV/NLT paid proxy) -- rides
      // the SAME allow-list too, for the same reason: written ONLY by the
      // setOrgBibleEnabled Cloud Function via the Admin SDK, no exemption for
      // a super-admin's own client SDK.
      function lifecycleFields() {
        // See ADR-0002 (docs/adr/0002-aimasterenabled-s-own-audit-trail-siblings.md)
        return ['active', 'deactivatedAt', 'deactivatedBy', 'reactivatedAt', 'reactivatedBy',
                'aiMasterEnabled', 'aiEnabledAt', 'aiEnabledBy', 'aiDisabledAt', 'aiDisabledBy',
                'bibleApiEnabled', 'bibleApiEnabledAt', 'bibleApiEnabledBy', 'bibleApiDisabledAt', 'bibleApiDisabledBy'];
      }
      // IN-01 (113-REVIEW): the former "create (no prior doc)" branch is
      // removed -- SEC-ISO-01 deleted the only `allow create` on
      // organizations/{orgId} that ever invoked this function in create
      // context, so it is now called exclusively from `allow update` below,
      // where `resource` is guaranteed non-null by Firestore's own operation
      // semantics (an `update` cannot target a nonexistent document). The
      // dead branch, if it somehow ran, was at least as restrictive as this
      // one -- removing it is not a security-relevant change.
      function preservesLifecycleFields() {
        return request.resource == null
          // Delete: nothing being written, nothing to restrict.
          ? true
          // Update (prior doc exists): diff against the stored doc, exactly
          // like the services/{docId} block's keys() helper below.
          : !request.resource.data.diff(resource.data).affectedKeys().hasAny(lifecycleFields());
      }

      // See ADR-0003 (docs/adr/0003-r233-t-80-02-t-80-03-createdby-is-a-provenance-audit-field-t.md)
      function preservesCreatedBy() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']);
      }

      // Members can read; editors can write
      allow read: if isOrgMember(orgId);
      // Editors can update existing orgs -- but never the 5 lifecycle fields.
      // NOTE (Phase 77, R216/T-77-04): this used to be `allow write`, which
      // bundles create+update+DELETE. `preservesLifecycleFields()` short-
      // circuits to `true` specifically on delete (`request.resource == null`
      // -- its own comment above reads "Delete: nothing being written,
      // nothing to restrict"), so under the old `write` rule an ordinary
      // editor could delete the org doc outright. Narrowing this to `update`
      // removes delete from this rule's coverage entirely -- `updateDoc(...)`
      // calls map exactly to Firestore's `update` operation, so every
      // existing T-76-10/T-76-06 test exercising this line is unaffected.
      // The explicit `allow delete: if false;` below is the ONLY rule now
      // governing delete on this document -- without this narrowing, that
      // DENY would have zero effect (Firestore OR-evaluates every matching
      // `allow` clause for an operation; the old `write` grant would still win).
      //
      // Phase 78 (R225 composition fix): the `|| isSuperAdmin()` disjunct
      // that used to live here is DELETED, not preserved. Before Phase 78,
      // isOrgEditor(orgId) required a genuine membership doc, so a
      // See ADR-0004 (docs/adr/0004-flow-1-org-creation-cr-01-getafter-alone-only-proves-created.md)
      allow update: if isOrgEditor(orgId) && preservesLifecycleFields() && preservesCreatedBy();
      // SEC-ISO-01 (Phase 112, High -- closed Phase 113): the legacy client-side
      // org self-provisioning path (the `allow create` that used to live here,
      // plus the members/{uid} Flow-1 disjunct below) is REMOVED outright.
      // `onboardOrganization` (Admin SDK, functions/src/orgProvisioning.ts) is
      // the ONLY sanctioned provisioner and bypasses these rules entirely --
      // any signed-in user could previously self-provision an org here
      // directly via the client SDK and squat a slug/name, bypassing that
      // super-admin-gated path. No `allow create` clause remains on this
      // collection; organizations have no client create path (falls through
      // to the file's catch-all deny).

      // Phase 77 (R216/T-77-04): deletion is Admin-SDK-only. The
      // deleteOrganization callable (orgDeletion.ts) uses the Admin SDK,
      // which bypasses rules entirely -- this DENY has zero effect on that
      // See ADR-0005 (docs/adr/0005-legitimate-deletion-path-it-exists-solely-to-close-the-clien.md)
      allow delete: if false;

      // Members subcollection
      // See .planning/codebase/ARCHITECTURE.md (Backend Behavioral Notes (R318) § firestore.rules)
      // IN-02 accepted residual: do NOT "fix" by narrowing isOrgEditor here.
      match /members/{uid} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgEditor(orgId);

        // R104 — replaces the unconditional `isSignedIn() && request.auth.uid == uid`,
        // which let ANY signed-in user self-join ANY org with a client-controlled role.
        // Both legitimate flows (see 40.1-RESEARCH.md, ensureUserDocument in
        // src/stores/auth.ts:264-350) are handled explicitly; nothing else authorizes
        // a create.
        // SEC-ISO-01 (Phase 112, High -- closed Phase 113): the Flow-1
        // org-creation disjunct that used to live here (the
        // !exists(.../organizations/$(orgId)) && getAfter(...).createdBy ==
        // request.auth.uid && role == 'editor' branch, see ADR-0004) is
        // REMOVED outright, alongside the organizations/{orgId} `allow create`
        // above. Only Flow 2 (invite acceptance) remains.
        allow create: if isSignedIn() && request.auth.uid == uid && (
          // Flow 2: invite acceptance. The invite doc predates this batch (created
          // earlier by an org editor via TeamView) and is being DELETED later in
          // THIS SAME batch (auth.ts:301) -- plain get()/exists() is correct here
          // specifically because it does NOT see that same-batch delete; it
          // reflects pre-batch state. request.auth.token.email is guarded non-null
          // first so `.lower()` never errors for an auth method with no email.
          // Role is compared against the invite's stored role, not trusted from
          // the client -- closes R104 criterion 4.
          (request.auth.token.email != null
            && exists(/databases/$(database)/documents/organizations/$(orgId)/invites/$(request.auth.token.email.lower()))
            && request.resource.data.role == get(/databases/$(database)/documents/organizations/$(orgId)/invites/$(request.auth.token.email.lower())).data.role)
        );
      }

      // Invites subcollection
      match /invites/{email} {
        allow read: if isOrgEditor(orgId);
        allow write: if isOrgEditor(orgId);
        allow delete: if isOrgEditor(orgId) || (isSignedIn() && request.auth.token.email.lower() == email);
      }

      // Services — viewers read; editors write only while the STORED status is
      // draft, with two explicit carve-outs (reopen, Planning Center export).
      //
      // Note the read is of `resource.data.status` (STORED), never
      // `request.resource.data.status` (INCOMING) — reading the incoming value
      // would let any write that also sets `status: 'draft'` edit a locked
      // service, which is precisely the payload an attacker would send.
      match /services/{docId} {
        function storedStatus() { return resource.data.get('status', 'draft'); }
        function keys() { return request.resource.data.diff(resource.data).affectedKeys(); }

        allow read:   if isOrgMember(orgId);
        allow create: if isOrgEditor(orgId) && request.resource.data.status == 'draft';
        allow delete: if isOrgEditor(orgId);
        allow update: if isOrgEditor(orgId) && (
          // 1. Ordinary editing — allowed only while the STORED status is draft.
          //    This also covers the draft -> planned transition (D-02).
          storedStatus() == 'draft'

          // 2. D-09 — the Planning Center export write. planned -> exported,
          //    carrying real export evidence. `hasAll(['pcExportedAt'])` (not
          //    pcPlanId) because affectedKeys() only reports CHANGED keys and a
          //    re-export to the same plan writes an unchanged pcPlanId.
          || (storedStatus() == 'planned'
              && request.resource.data.status == 'exported'
              && keys().hasOnly(['status','pcExportedAt','pcPlanId','updatedAt'])
              && keys().hasAll(['pcExportedAt'])
              && request.resource.data.pcPlanId is string)

          // 3. R037 — Reopen. The ONLY status-reverting write. hasOnly() is what
          //    stops "reopen" being used to smuggle a slots rewrite alongside the
          //    status change. D-11's pcExportedAt/pcPlanId are untouched by design.
          || (request.resource.data.status == 'draft'
              && keys().hasOnly(['status','updatedAt']))
        );

        // Messages — the queue of volunteer notifications for this service (R130).
        // See .planning/codebase/INTEGRATIONS.md (Backend Integration Notes (R318) § firestore.rules)
        match /messages/{messageId} {
          allow read:   if isOrgMember(orgId);
          allow create: if isOrgEditor(orgId);
          allow update, delete: if false;

          // Recipients — per-recipient delivery status for a message.
          // Admin-SDK-only end to end: even the editor who created the parent
          // message cannot write here. Only isOrgMember read is granted so
          // the UI can show delivery status once the Admin SDK populates it.
          match /recipients/{recipientId} {
            allow read:  if isOrgMember(orgId);
            allow write: if false;
          }
        }

        // Lock snapshots — captured at service-lock time (R132), unlike
        // pptxRenders/messages this IS client-writable: an org editor writes
        // the snapshot directly when locking a service (Phase 61). Member
        // read, editor write, both scoped to this org via isOrgMember/
        // isOrgEditor resolving orgId from the path segment (no client field
        // trusted), so cross-org access is structurally impossible.
        match /lockSnapshots/{snapshotId} {
          allow read:  if isOrgMember(orgId);
          allow write: if isOrgEditor(orgId);
        }
      }

      // Slide groups — one doc per slot (doc id IS the slot id), so the parent
      // service is reachable only via the serviceId FIELD. Two extra billed
      // reads per write (exists + get); 3 of the 10-call budget once
      // isOrgEditor's own get() is counted.
      match /slideGroups/{groupId} {
        function svcPath(sid) {
          return /databases/$(database)/documents/organizations/$(orgId)/services/$(sid);
        }
        function parentDraft(sid) {
          return exists(svcPath(sid)) && get(svcPath(sid)).data.get('status','draft') == 'draft';
        }
        function parentGone(sid) { return !exists(svcPath(sid)); }

        allow read: if isOrgMember(orgId);

        allow create: if isOrgEditor(orgId)
          && request.resource.data.keys().hasAll(['serviceId'])
          && parentDraft(request.resource.data.serviceId);

        // serviceId is immutable (mirrors quarterShares' orgId immutability,
        // firestore.rules:118) — otherwise a group could be re-parented from a
        // draft service onto a locked one and edited through the seam.
        allow update: if isOrgEditor(orgId)
          && resource.data.keys().hasAll(['serviceId'])
          && request.resource.data.serviceId == resource.data.serviceId
          && parentDraft(resource.data.serviceId);

        // Delete is deliberately MORE permissive than update: an orphan (parent
        // service deleted) or a legacy doc with no serviceId must remain
        // deletable, or it is wedged in the database forever with no cleanup path.
        allow delete: if isOrgEditor(orgId)
          // See .planning/codebase/ARCHITECTURE.md (Backend Behavioral Notes (R318) § firestore.rules)
          // resource == null MUST be the first operand and MUST stay first (third recurrence, 2026-08-12).
          && (resource == null
              || !resource.data.keys().hasAll(['serviceId'])
              || resource.data.serviceId == null
              || parentGone(resource.data.serviceId)
              || parentDraft(resource.data.serviceId));
      }

      // Songs — editors only (viewers cannot read songs)
      match /songs/{songId} {
        allow read, write: if isOrgEditor(orgId);

        // Lyrics versions subcollection (Phase 18) — editors only.
        // Required explicitly: the /{collection}/{docId} catch-all below only
        // matches single-segment subcollections directly under the org, so this
        // deeper path would otherwise fall through to the global deny-all,
        // breaking the Lyrics tab and slideshow auto-assembly with permission-denied.
        match /lyrics/{lyricsId} {
          allow read, write: if isOrgEditor(orgId);
        }
      }

      // pptxRenders — render-status doc for an imported PowerPoint deck (R062, Phase 42).
      // See .planning/codebase/INTEGRATIONS.md (Backend Integration Notes (R318) § firestore.rules)
      match /pptxRenders/{importId} {
        allow read: if isOrgMember(orgId);
      }

      // All other nested collections — editors only.
      // See .planning/codebase/ARCHITECTURE.md (Backend Behavioral Notes (R318) § firestore.rules)
      // ★ `collection != 'services'`, `collection != 'slideGroups'` AND `collection != 'pptxRenders'`
      // are all LOAD-BEARING. Do not remove any of the three.
      match /{collection}/{docId} {
        allow read: if isOrgEditor(orgId);
        allow write: if isOrgEditor(orgId)
          && collection != 'services'
          && collection != 'slideGroups'
          && collection != 'pptxRenders';
      }
    }

    // inviteLookup — stores pending invite records keyed by normalized email
    match /inviteLookup/{email} {
      allow read: if isSignedIn() && request.auth.token.email.lower() == email;
      // R232/T-80-01: was `isSignedIn()` alone, which let ANY signed-in user
      // create an inviteLookup doc whose `orgId` targets a church they do
      // not administer -- a self-invite privilege-forgery vector (accept the
      // invite via the first-login flow at a role of the attacker's own
      // choosing). Mirrors the orgSlugs/orgNames create-gate idiom verbatim.
      // TeamView.vue's onInvite() already writes `orgId` onto this payload in
      // the same batch as the invite doc, so no client change is needed.
      allow create: if isSignedIn() && isOrgEditor(request.resource.data.orgId);
      allow delete: if isSignedIn() && (
        request.auth.token.email.lower() == email ||
        isOrgEditor(resource.data.orgId)
      );
    }

    // Share tokens: public read (anyone with token URL), editor-scoped create,
    // editor-scoped update, editor-scoped delete.
    match /shareTokens/{token} {
      // SEC-S-01 (Phase 112, Critical -- closed Phase 113): split get/list.
      // `allow read: if true` grants BOTH get and list -- an unauthenticated
      // getDocs(collection(db, 'shareTokens')) could enumerate every org's
      // share tokens (and via them every shared service/quarter). The public
      // share-link flow only ever does a getDoc()-by-id, so narrowing to
      // get-only preserves it while closing the enumeration leak.
      //
      // CR-01 (113-REVIEW, closed same phase): `allow list: if false;` also
      // denied the legitimate `list`s this collection needs -- both
      // deleteService() and ensureShareLink()'s adoption query (both in
      // src/stores/services.ts) query by `serviceId` to find every token
      // for a service, since a service can have 2+ tokens and their ids
      // aren't known up front. An unconditional deny silently broke both
      // (see CR-02, 113-REVIEW-2, for ensureShareLink's fix). Org-gating
      // instead of flat-denying closes the enumeration leak (still no
      // unauthenticated or cross-org list) while letting an org editor
      // list their OWN org's tokens -- every call site is required to add
      // `where('orgId','==', orgId)` to its query so this
      // resource.data.orgId check is satisfiable (Firestore requires an
      // equality filter on any field a list rule reads from resource.data).
      allow get: if true;
      // IN-02 (113-REVIEW-2): isOrgEditor() already opens with isSignedIn()
      // (see helper above), so the outer isSignedIn() here was dead weight.
      // Dropped for consistency with every other isOrgEditor-gated rule in
      // this file (orgSlugs, orgNames, serviceShareLinks, ...).
      allow list: if isOrgEditor(resource.data.orgId);
      // See ADR-0006 (docs/adr/0006-was-issignedin-with-no-org-check-phase-41-s-adoption-logic.md)
      // a behavior change for any sanctioned path — mirrors
      // serviceShareLinks/quarterShares/serviceShares' isOrgEditor idiom.
      allow create: if isOrgEditor(request.resource.data.orgId);
      // See ADR-0004 (docs/adr/0004-flow-1-org-creation-cr-01-getafter-alone-only-proves-created.md)
      allow update: if isOrgEditor(resource.data.orgId)
                       && request.resource.data.orgId == resource.data.orgId;
      // Delete allowed so an org editor can revoke a share when its quarter is deleted
      // (quarters store deleteQuarter). Scoped to the orgId stored on the token doc so
      // one org can never revoke another org's link.
      allow delete: if isOrgEditor(resource.data.orgId);
    }

    // See ADR-0004 (docs/adr/0004-flow-1-org-creation-cr-01-getafter-alone-only-proves-created.md)
    match /serviceShareLinks/{serviceId} {
      // See .planning/codebase/ARCHITECTURE.md (Backend Behavioral Notes (R318) § firestore.rules)
      // T-41-09: the `resource == null` branch is load-bearing, not decorative -- do not remove it.
      allow read: if isSignedIn()
                     && (resource == null || isOrgEditor(resource.data.orgId));
      allow create: if isOrgEditor(request.resource.data.orgId);
      allow update: if isOrgEditor(resource.data.orgId)
                       && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isOrgEditor(resource.data.orgId);
    }

    // See ADR-0007 (docs/adr/0007-org-slug-claims-public-read-org-editor-scoped-create-only.md)
    match /orgSlugs/{slug} {
      allow read: if true;
      allow create: if isOrgEditor(request.resource.data.orgId);
      allow update, delete: if false;
    }

    // Org NAME uniqueness registry (mirrors orgSlugs). `orgNames/{normalizedName}`
    // is created once, create-only, keyed by the normalized display name — so no
    // two organizations can hold the same name (create-once = first-writer-wins;
    // the denied overwrite is how claimOrgName detects a collision). Create
    // requires the caller to be an editor of the orgId in the payload (no
    // name-squatting for an arbitrary/victim org).
    match /orgNames/{nameKey} {
      allow read: if true;
      allow create: if isOrgEditor(request.resource.data.orgId);
      allow update, delete: if false;
    }

    // See ADR-0004 (docs/adr/0004-flow-1-org-creation-cr-01-getafter-alone-only-proves-created.md)
    match /quarterShares/{shareId} {
      // SEC-S-01 (Phase 112, Critical -- closed Phase 113): see shareTokens above.
      allow get: if true;
      allow list: if false;
      allow create: if isOrgEditor(request.resource.data.orgId);
      allow update: if isOrgEditor(resource.data.orgId)
                       && request.resource.data.orgId == resource.data.orgId;
      // Delete allowed so an org editor can revoke the memorable share when its quarter
      // is deleted (deleteQuarter), scoped to the owning orgId on the doc.
      allow delete: if isOrgEditor(resource.data.orgId);
    }

    // Memorable-URL per-service shares: public read, org-editor-scoped create/update
    // (overwritten in place on every finalize, unlike frozen shareTokens). Mirrors
    // quarterShares: shareId is a guessable, deterministic string
    // (`${slug}__service-${date}`), so isSignedIn() alone would let any authenticated
    // user of ANY org overwrite another org's public share doc. Both create and update
    // require the caller to be an editor of the orgId embedded in the doc, and update
    // additionally forbids changing orgId (no reassigning a share to a different org).
    match /serviceShares/{shareId} {
      // SEC-S-01 (Phase 112, Critical -- closed Phase 113): see shareTokens above.
      allow get: if true;
      allow list: if false;
      allow create: if isOrgEditor(request.resource.data.orgId);
      allow update: if isOrgEditor(resource.data.orgId)
                       && request.resource.data.orgId == resource.data.orgId;
      // Delete allowed so an org editor can revoke the memorable share when its service
      // is deleted, scoped to the owning orgId on the doc.
      allow delete: if isOrgEditor(resource.data.orgId);
    }

    // AI usage ledger (R163) — one entry per proxied Claude request.
    // See .planning/codebase/INTEGRATIONS.md (Backend Integration Notes (R318) § firestore.rules)
    match /aiUsage/{docId} {
      allow read, write: if false;
    }

    // AI proxy rate-limit counters (R161) — same rationale/status as aiUsage above.
    match /aiRateLimits/{docId} {
      allow read, write: if false;
    }

    // appConfig — Phase 68 Plan 03 (R178): RULES ONLY. This block gates the
    // collection to super-admins; it does NOT define or validate the doc's
    // contents/schema — that belongs to appConfig/global's managed values
    // and the Cloud Functions that read it at runtime (Phase 69). No doc is
    // written by this plan.
    match /appConfig/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // superAdmins — Phase 68 Plan 03 (R178): document existence = granted
    // (source of truth for the `superAdmin` custom claim; syncSuperAdminClaim,
    // Plan 02, mirrors that claim off writes here via the Admin SDK, which
    // bypasses these rules entirely). Client read/write gated to existing
    // super-admins only — the setSuperAdminClaim onCall (Plan 02) re-checks
    // the caller server-side before writing, so this rule is defense-in-depth
    // for direct client SDK access, not the only guard.
    match /superAdmins/{uid} {
      allow read, write: if isSuperAdmin();
    }

    // Catch-all: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
