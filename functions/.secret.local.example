# functions/.secret.local — Firebase Functions EMULATOR local secret overrides.
#
# Copy this file to `functions/.secret.local` (gitignored) before running the
# Functions emulator locally:
#
#     cp functions/.secret.local.example functions/.secret.local
#
# WHY IT IS REQUIRED (v1.7 send path):
# Two Functions bind secrets that were never deployed to Google Secret Manager:
#   - sendQueuedMessage (onDocumentCreated)  -> secrets: [RESEND_API_KEY]
#   - messageWebhook    (onRequest)          -> secrets: [RESEND_WEBHOOK_SECRET]
# When the emulator starts a worker for a secret-bound trigger it runs
# resolveSecretEnvs(): every bound secret NOT present in this file is fetched from
# Google Secret Manager (accessSecretVersion). With the secret undeployed, that
# call fails/stalls, the sendQueuedMessage worker never runs its handler, and
# every queued message is stuck at status "queued" (the composer + message
# history show "Sending…" forever). Listing the keys here makes the emulator read
# them locally and SKIP the Secret Manager call, so the send trigger runs.
#
# The values below are PLACEHOLDERS — they are NOT valid Resend credentials and
# will not deliver real email (Resend returns 401 for a fake key). That is fine
# for exercising the queue/trigger/idempotency/recipient-resolution path. To send
# real email from the local emulator, put a real `re_...` key in your own
# functions/.secret.local (never commit it — .secret.local is gitignored).
#
# After creating/editing functions/.secret.local you must RESTART the emulator:
# secret resolution and trigger registration happen at emulator startup.
RESEND_API_KEY=re_local_emulator_placeholder_not_a_real_key
RESEND_WEBHOOK_SECRET=whsec_local_emulator_placeholder_not_a_real_secret
