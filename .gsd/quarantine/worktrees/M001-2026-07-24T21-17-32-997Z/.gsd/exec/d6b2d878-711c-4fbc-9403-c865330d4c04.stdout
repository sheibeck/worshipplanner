=== TC-03: Distinct styling per speaker ===
--- Leader styling ---
32:          class="flex-1 rounded-md bg-gray-800 border border-gray-700 text-gray-100 placeholder-gray-500 text-sm px-3 py-2 focus:outline-none focus:ring-1 focus:ring-indigo-500"
41:            ? 'text-indigo-400 bg-gray-800 border-gray-700 hover:bg-gray-700'
68:            ? 'bg-gray-800/50 border-indigo-700/50'
81:                ? 'text-indigo-300 bg-indigo-900/50'
109:              :class="section.speaker === 'LEADER' ? 'text-indigo-400' : 'text-amber-400'"

--- Congregation styling ---
82:                : 'text-amber-300 bg-amber-900/50'"
109:              :class="section.speaker === 'LEADER' ? 'text-indigo-400' : 'text-amber-400'"
157:    speaker: (idx % 2 === 0 ? 'LEADER' : 'CONGREGATION') as 'LEADER' | 'CONGREGATION',
205:    speaker: section.speaker === 'LEADER' ? 'CONGREGATION' : 'LEADER',
244:          speaker: (idx % 2 === 0 ? 'LEADER' : 'CONGREGATION') as 'LEADER' | 'CONGREGATION',

--- Preview panel section styling ---
        <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Preview</h4>
        <div class="space-y-2">
          <div
            v-for="(section, idx) in sections"
            :key="`preview-${idx}`"
            :data-testid="`preview-section-${idx}`"
          >
            <span
              class="text-xs uppercase tracking-wider mr-2"
              :class="section.speaker === 'LEADER' ? 'text-indigo-400' : 'text-amber-400'"
              :data-testid="`preview-label-${idx}`"
            >
              {{ section.speaker === 'LEADER' ? 'Leader:' : 'Congregation:' }}
            </span>
            <span
              :class="section.speaker === 'LEADER'
                ? 'text-gray-100 font-semibold text-sm'
                : 'text-gray-300 font-normal text-sm pl-2'"
            >
              {{ section.text }}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
